<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Analytics &amp; Warnings"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Students with attendance below 75% threshold"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/layoutWarningsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvWarningHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Attendance Shortage Warning List"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/accent_rose"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvWarningsList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading warning list..."
                android:textSize="14sp"
                android:textColor="@color/text_primary"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
